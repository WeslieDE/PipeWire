#!/usr/bin/env bash
# Eigener, dünner AppRun-Wrapper: setzt nur die PipeWire-spezifischen
# Umgebungsvariablen (SPA-Plugins/Module werden zur Laufzeit per dlopen
# geladen, nicht als normale Bibliotheksabhängigkeit erkannt) und reicht dann
# an das von linuxdeploy-plugin-qt generierte AppRun.qt weiter, das die
# gesamte Qt/WebEngine-Umgebung (LD_LIBRARY_PATH, QT_PLUGIN_PATH,
# QTWEBENGINEPROCESS_PATH, ...) korrekt aufsetzt.
HERE="$(dirname "$(readlink -f "${0}")")"

export SPA_PLUGIN_DIR="$HERE/usr/lib/spa-0.2"
export PIPEWIRE_MODULE_DIR="$HERE/usr/lib/pipewire-0.3"

exec "$HERE/AppRun.qt" "$@"
